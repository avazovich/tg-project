# Copy to .env.local and fill in real values. Never commit .env.local.

# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Shared secret Telegram sends back on every webhook call, proving the request
# is really from Telegram. Generate with: openssl rand -hex 24
# Must also be set on the Edge Function: npx supabase secrets set TELEGRAM_WEBHOOK_SECRET=...
TELEGRAM_WEBHOOK_SECRET=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
